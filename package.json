{
  "name": "@bluehexagons/capacitor",
  "version": "0.5.0",
  "description": "Capacitor is a client/server synchronization utility written for Antistatic",
  "keywords": [
    "client-server",
    "fifo",
    "interpolation",
    "networking",
    "state-sync",
    "synchronization"
  ],
  "homepage": "https://github.com/bluehexagons/capacitor#readme",
  "bugs": {
    "url": "https://github.com/bluehexagons/capacitor/issues"
  },
  "license": "Apache-2.0",
  "author": "bluehexagons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluehexagons/capacitor.git"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "build/src"
  ],
  "type": "module",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js"
    }
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "fix": "oxlint --fix . && npm run format",
    "clean": "node -e \"for (const path of ['build', 'coverage']) { try { require('node:fs').rmSync(path, { recursive: true, force: true }); } catch {} }\"",
    "compile": "tsc --pretty",
    "watch": "tsc --watch --pretty",
    "release": "node scripts/release.mjs",
    "pretest": "npm run compile",
    "prepack": "npm run compile",
    "prepublishOnly": "npm run compile"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "jest": "^30.3.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
