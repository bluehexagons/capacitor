{
  "name": "@bluehexagons/capacitor",
  "version": "0.7.0",
  "description": "Transport-neutral frame synchronization and rollback primitives",
  "keywords": [
    "client-server",
    "fifo",
    "game-networking",
    "input-synchronization",
    "interpolation",
    "networking",
    "rollback-netcode",
    "state-sync",
    "synchronization"
  ],
  "homepage": "https://github.com/bluehexagons/capacitor#readme",
  "bugs": {
    "url": "https://github.com/bluehexagons/capacitor/issues"
  },
  "license": "Apache-2.0",
  "author": "bluehexagons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluehexagons/capacitor.git"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "build/src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js"
    }
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js build/test",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm test && npm run lint && npm run format:check",
    "fix": "oxlint --fix . && npm run format",
    "clean": "node -e \"for (const path of ['build', 'coverage']) { try { require('node:fs').rmSync(path, { recursive: true, force: true }); } catch {} }\"",
    "compile": "tsc --pretty",
    "watch": "tsc --watch --pretty",
    "release": "node scripts/release.mjs",
    "pretest": "npm run compile",
    "prepack": "npm run compile",
    "prepublishOnly": "npm run compile"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
